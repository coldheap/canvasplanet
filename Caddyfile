(cloudflare_only) {
	# TRUST_CF_CONNECTING_IP is safe only when direct origin traffic cannot
	# reach the app. Match the actual TCP peer here (not a forwarded header),
	# using Cloudflare's published IPv4/IPv6 edge ranges.
	@direct not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	# Keep this as a handle so Caddy evaluates it before the route-specific
	# handles below; a top-level respond directive sorts after handle blocks.
	handle @direct {
		respond "Forbidden" 403
	}
}

{$DOMAIN} {
	import cloudflare_only
	encode zstd gzip

	# ---- canvas tiles -------------------------------------------------
	# The heaviest route by far. s-maxage lets Cloudflare hold these at the
	# edge for a day; the tile worker purges explicitly when a tile changes,
	# so a long edge TTL is safe. max-age=0 keeps browsers revalidating so a
	# purge is picked up immediately.
	handle /tiles/* {
		header Cache-Control "public, max-age=0, s-maxage=86400"
		reverse_proxy {$APP_UPSTREAM:app:8080}
	}

	# ---- static land/ocean backdrop ------------------------------------
	# Pre-baked (`pnpm geo:bake-basemap`), never invalidated by the tile
	# worker the way /tiles/* is — a long edge TTL is always safe here.
	handle /basemap/* {
		header Cache-Control "public, max-age=86400, s-maxage=604800"
		reverse_proxy {$APP_UPSTREAM:app:8080}
	}

	# ---- user profile pictures -----------------------------------------
	# Revisioned URLs are safe to cache; replacements get a new URL.
	handle /avatars/* {
		reverse_proxy {$APP_UPSTREAM:app:8080}
	}

	# ---- websocket ----------------------------------------------------
	handle /ws {
		reverse_proxy {$APP_UPSTREAM:app:8080}
	}

	# ---- api ----------------------------------------------------------
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy {$APP_UPSTREAM:app:8080}
	}

	# ---- embeddable widget (ROADMAP.md §4.2) ---------------------------
	# The one page on this domain that is SUPPOSED to sit inside someone
	# else's <iframe> — everything else gets X-Frame-Options: DENY below,
	# so this has to be carved out explicitly rather than left as a gap.
	handle /embed.html {
		header Cache-Control "no-cache"
		header Content-Security-Policy "frame-ancestors *"
		root * {$WEB_ROOT:/srv/web}
		file_server
	}

	# ---- legal pages ---------------------------------------------------
	# terms.html and privacy.html are plain static files in web/public/, so
	# the SPA block below already serves them at their real paths. This adds
	# only the extensionless aliases people type and link to — without it
	# `try_files {path} /index.html` would swallow /terms and hand back the
	# canvas instead, which is a confusing 200 rather than an honest 404.
	#
	# A redirect, not a second way to serve the same bytes: the .html form is
	# what the app itself links to (see LegalFooter.tsx, which must keep the
	# extension because Vite's dev server has no equivalent of this block),
	# so pointing both at one canonical URL keeps that honest.
	@legal path /terms /privacy
	handle @legal {
		redir {path}.html permanent
	}

	# ---- SPA ----------------------------------------------------------
	handle {
		root * {$WEB_ROOT:/srv/web}
		# Hashed asset filenames are immutable; index.html never is.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header Cache-Control "no-cache"
		# The interactive app (paint, admin, charges) has no reason to ever
		# run inside someone else's frame — only /embed.html does. Denying
		# framing here is what makes that carve-out a deliberate exception
		# rather than an oversight elsewhere.
		header X-Frame-Options "DENY"
		header Content-Security-Policy "frame-ancestors 'none'"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# ---- status subdomain -------------------------------------------------
# A separate host on purpose: if the main domain, its DNS, or the Cloudflare
# proxy in front of it is the thing that's down, a status page living under
# that same host goes down with it. This is a standalone static page plus
# one proxied JSON route — it depends on nothing from the SPA build.
#
# Needs its own DNS record (status.{$DOMAIN} -> this box); Caddy handles the
# certificate automatically once that resolves, same as the main block.
status.{$DOMAIN} {
	import cloudflare_only
	encode zstd gzip

	handle /api/status {
		header Cache-Control "no-store"
		reverse_proxy {$APP_UPSTREAM:app:8080}
	}

	handle {
		root * {$STATUS_ROOT:/srv/status}
		header Cache-Control "no-cache"
		header X-Frame-Options "DENY"
		header Content-Security-Policy "frame-ancestors 'none'"
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
