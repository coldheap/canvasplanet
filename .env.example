# ---- core ----
NODE_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:5173

# ---- database ----
POSTGRES_USER=worldcanvas
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=worldcanvas
DATABASE_URL=postgres://worldcanvas:change-me-in-production@localhost:5432/worldcanvas

# ---- sessions ----
# 32+ random bytes. Rotating this invalidates every anonymous session
# (users lose their charge bank, not their pixels).
SESSION_SECRET=generate-with-openssl-rand-hex-32

# ---- staff ----
# Bootstrap only: `pnpm staff:create` uses this to mint the first admin
# account, then you should unset it. Every admin after that is granted from
# the Users tab by an existing admin — staff is a role on a normal account,
# not a separate login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- cloudflare (optional in dev; required in prod for tile purging) ----
CF_API_TOKEN=
CF_ZONE_ID=
CF_PURGE_ENABLED=false

# ---- player accounts (ROADMAP.md §5.1) ----
# SMTP is the one interface every provider speaks, including Resend's own
# relay (smtp.resend.com, user "resend", pass = your Resend API key) — so
# prod and dev differ only in which host answers, not in how the app talks
# to it. Defaults below (localhost:1025, no auth) target a local `maildev`
# catcher for dev — see README "Verifying it works" / `pnpm mail:dev`.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Worldcanvas <noreply@worldcanvas.live>

# ---- turnstile (anti-bot, layer 1) ----
# Leave blank in dev to disable the first-paint challenge entirely.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# ---- tuning (all have safe defaults in shared/config.ts) ----
TILE_CACHE_DIR=./tilecache
GEO_INDEX_PATH=./data/geo-index.bin
TILE_WORKER_INTERVAL_MS=2000

# ---- timelapse export (ROADMAP.md §4.3) ----
# Requires `ffmpeg` on PATH (already in the Docker image; install separately
# for a bare-metal/no-Docker dev box, see README "No Docker?").
EXPORT_OUTPUT_DIR=./exports
EXPORT_EXPIRY_HOURS=36

# Trust CF-Connecting-IP for the client address. ONLY set this true when a
# proxy that overwrites the header (Cloudflare) is in front of the origin.
# On a directly reachable origin this lets anyone forge a fresh IP per
# request and bypass the IP budget entirely.
TRUST_CF_CONNECTING_IP=false

# ---- backups (pnpm backup / scripts/backup.sh) ----
# Local dumps land in BACKUP_DIR regardless of the rest of this section.
BACKUP_DIR=./backups
# Any rclone destination (an rclone remote name, or a path rclone can reach —
# S3, B2, sftp...). Without this, backups never leave the box they protect
# against — see ROADMAP.md §3.2. Requires `rclone` installed and configured.
BACKUP_REMOTE=
# Optional server-side toggle: renders the heatmap tile pyramid on every
# paint alongside the colour one (see ROADMAP.md §2.4/§2.5). Default on.
HEATMAP_WORKER=true

# ---- alerting (pnpm alert:watch) ----
# A separate, independent process (not the app itself) that polls
# /api/status and pushes a notification on state changes — see
# ROADMAP.md §3.3. Being a separate process is the point: it still detects
# an outage if the app process itself is the thing that died.
ALERT_STATUS_URL=http://localhost:8080/api/status
# Any endpoint that accepts a JSON POST with a `text` field works — Slack
# and Discord incoming webhooks both accept this payload as-is. Blank
# disables pushed notifications; the watcher still logs transitions to
# stdout, so `pnpm alert:watch >> alerts.log &` is useful even without one.
ALERT_WEBHOOK_URL=
ALERT_POLL_INTERVAL_MS=30000
# Consecutive failing polls required before alerting, so one slow response
# doesn't page anyone.
ALERT_FAIL_THRESHOLD=2
# While still down, re-notify at most this often rather than on every poll.
ALERT_RENOTIFY_MS=900000

# Failed logins allowed per IP per 15 minutes. Default 20. Raise ONLY for
# local test runs, where every client shares 127.0.0.1.
LOGIN_MAX_ATTEMPTS=
